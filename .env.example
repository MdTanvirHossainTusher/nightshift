# Copy to .env for local runs. Everything here is optional: with no keys set,
# Nightshift uses the offline `heuristic` provider, skips the git push, and
# delivers email to MailHog. The demo works with this file untouched.

# ── Model provider ───────────────────────────────────────────────────────────
# heuristic | openai | gemini | anthropic | claude-code | bob
NIGHTSHIFT_LLM_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Pull requests ────────────────────────────────────────────────────────────
# A fine-grained PAT with contents:write + pull_requests:write on the target repo
# ONLY. Never a token that can reach anything else.
GITHUB_TOKEN=
NIGHTSHIFT_GIT_REPO=MdTanvirHossainTusher/nightshift
NIGHTSHIFT_GIT_BASE_BRANCH=main
# Dry run: do everything except push and open the PR. Leave true until you have
# watched a diff you agree with.
NIGHTSHIFT_PUBLISH_DRY_RUN=true

# ── Notifications ────────────────────────────────────────────────────────────
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
NIGHTSHIFT_NOTIFY_FROM=nightshift@example.com

# ── Scanning ─────────────────────────────────────────────────────────────────
NIGHTSHIFT_LOG_ROOT=./demo/logs
NIGHTSHIFT_WORKSPACE=./workspace
# Cron for the overnight run. Default 02:00 daily.
NIGHTSHIFT_SCAN_CRON=0 0 2 * * *

# ── Outbox transport ─────────────────────────────────────────────────────────
NIGHTSHIFT_MESSAGING_TRANSPORT=local
